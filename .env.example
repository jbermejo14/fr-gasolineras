# URL base para canonicals, open graph y sitemap (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identificador de editor de Google AdSense (ca-pub- y 16 dígitos).
# Vacío por defecto: sin AdSense y sin botón "Configurar cookies".
NEXT_PUBLIC_ADSENSE_CLIENT=

# Unidad de anuncio de AdSense (10 dígitos). Vacía: sin bloques de anuncio.
NEXT_PUBLIC_ADSENSE_SLOT=
